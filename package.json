{
  "name": "aaas",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Agent-as-a-Service: plugin-based triggers (cron / manual / webhook) that drive coding agents (pi / ...)",
  "engines": {
    "node": ">=22.19"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:server": "AAAS_DEV=1 tsx watch src/server/main.ts",
    "dev:web": "npm --prefix web run dev",
    "start": "tsx src/server/main.ts",
    "cli": "tsx src/cli.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit && npm --prefix web run typecheck",
    "build": "npm --prefix web run build",
    "test": "node --import tsx --test --test-concurrency=1 'src/**/*.test.ts'",
    "test:e2e": "node --import tsx --test --test-concurrency=1 'tests/e2e/*.test.ts'",
    "coverage": "node scripts/coverage-gate.mjs",
    "check": "npm run typecheck && npm run test",
    "smoke": "node --import tsx scripts/smoke.ts",
    "e2e": "npm run test:e2e"
  },
  "dependencies": {
    "@fastify/static": "^10.1.2",
    "@fastify/websocket": "^11.2.0",
    "croner": "^9.1.0",
    "fastify": "^5.6.1",
    "yaml": "^2.8.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "tsx": "^4.20.6",
    "typescript": "5.9.3"
  }
}
